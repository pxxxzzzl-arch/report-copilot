data/parsed/*
!data/parsed/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Docker 数据卷（阶段 4 起本地服务的数据目录）
deploy/volumes/

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
