# =============================================================================
# 配置模板：复制为 .env 后填入真实值（.env 已在 .gitignore 中，不会提交）
#   cp .env.example .env
# 规则：嵌套配置用双下划线分隔，例如 LLM__BASE_URL 对应 settings.llm.base_url
# 未填写的项使用 config.py 里的默认值
# =============================================================================

# ---------- 路径 ----------
PATHS__RAW_DIR=data/raw
PATHS__PARSED_DIR=data/parsed
PATHS__MANIFEST_PATH=data/manifest.csv
PATHS__EXPERIMENTS_DIR=experiments
PATHS__GOLDSET_PATH=eval/goldset.jsonl

# ---------- 大模型（任意 OpenAI 兼容接口）----------
LLM__BASE_URL=https://api.example.com/v1
LLM__API_KEY=replace-me
LLM__MODEL=replace-me
LLM__TIMEOUT_S=60

# ---------- Embedding ----------
# provider=local：本地用 FlagEmbedding 加载模型
# provider=openai_compat：调用 OpenAI 兼容的 Embedding API（需填 API_BASE / API_KEY）
EMBEDDING__PROVIDER=local
EMBEDDING__MODEL_NAME=BAAI/bge-m3
# 本地模型目录；留空则从 HuggingFace 按 MODEL_NAME 下载
EMBEDDING__MODEL_PATH=data/models/bge-m3
EMBEDDING__API_BASE=
EMBEDDING__API_KEY=
# 可选 cpu / mps（Apple 芯片）/ cuda
EMBEDDING__DEVICE=cpu
EMBEDDING__BATCH_SIZE=16

# ---------- 切分与建索引 ----------
CHUNK__CHUNKER=fixed
CHUNK__CHUNK_SIZE=500
CHUNK__OVERLAP=50
INDEX__MAX_LENGTH=1024
INDEX__UPSERT_BATCH=256

# ---------- Reranker ----------
RERANKER__MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER__DEVICE=cpu

# ---------- 存储 ----------
STORE__QDRANT_URL=http://localhost:6333
STORE__QDRANT_COLLECTION=report_chunks
STORE__POSTGRES_DSN=postgresql://copilot:replace-me@localhost:5432/copilot
STORE__REDIS_URL=redis://localhost:6379/0

# ---------- 巨潮资讯网（年报下载）----------
CNINFO__STOCK_LIST_URL=http://www.cninfo.com.cn/new/data/szse_stock.json
CNINFO__QUERY_URL=http://www.cninfo.com.cn/new/hisAnnouncement/query
CNINFO__STATIC_BASE_URL=http://static.cninfo.com.cn/
CNINFO__REQUEST_INTERVAL_S=1.0
CNINFO__TIMEOUT_S=30
CNINFO__MAX_RETRIES=3

# ---------- PDF 预检阈值 ----------
PRECHECK__MIN_TEXT_CHARS=30
PRECHECK__SCAN_IMAGE_RATIO=0.5
PRECHECK__GARBLED_RATIO=0.1

# ---------- 检索评测 ----------
# 冻结的评测集版本与 sha256；评测集文件与之不符时 run_eval 拒绝运行
EVAL__GOLDSET_VERSION=v1
EVAL__GOLDSET_SHA256=cc1f43caf4e3e629e27d266703912ca1df44d5d6b3a7c2182c17fb9167208d2e
# 必须包含 5 和 10（log.csv 固定记录 hit@5 / recall@5 / mrr@10）
EVAL__K_VALUES=[1,3,5,10]

# ---------- 日志 ----------
LOG__LEVEL=INFO
# true 输出单行 JSON（便于检索排障）；false 输出人类可读格式（便于本地调试）
LOG__JSON_FORMAT=true
